DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# The public host Twilio reaches this server on, without https://, e.g. voice.getdossier.org
PUBLIC_HOST_NAME=
# Twilio console > Account info > Auth Token. Used to check requests come from Twilio.
TWILIO_AUTH_TOKEN=
# A long random string. The same value is set on the getdossier.org Worker as CALL_INTAKE_TOKEN.
CALL_INTAKE_TOKEN=
# Where finished calls are sent. Defaults to https://getdossier.org/demo/api/inbound/call
CALL_INTAKE_URL=
